---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
---

<Layout title={`Administración | ${SITE_CONFIG.name}`}>
  <main id="admin-container" class="min-h-screen bg-gray-950 text-white p-6 max-w-5xl mx-auto hidden">
    <header class="flex justify-between items-center mb-8 pb-4 border-b border-gray-800">
      <div>
        <h1 class="text-2xl font-bold">Panel de Administración</h1>
        <p class="text-xs text-gray-400">Gestión de repertorio y recursos - {SITE_CONFIG.name}</p>
      </div>
      <a href="/" class="px-4 py-2 bg-gray-800 hover:bg-gray-700 rounded-lg text-sm transition">
        ← Volver al Aula
      </a>
    </header>

    <section class="bg-gray-900 border border-gray-800 rounded-xl p-6 mb-8 shadow-xl">
      <h2 class="text-lg font-semibold mb-4 text-amber-400">Subir Nueva Pista o Recurso</h2>
      <form id="upload-track-form" class="space-y-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-300 uppercase mb-1">Título de la Obra</label>
            <input type="text" id="title" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm" placeholder="Ej: Concierto para Trompeta" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-300 uppercase mb-1">Compositor / Autor</label>
            <input type="text" id="composer" required class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm" placeholder="Ej: J. Haydn" />
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-gray-300 uppercase mb-1">Archivo de Audio (MP3)</label>
            <input type="file" id="audio-file" accept="audio/mp3,audio/mpeg" required class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-amber-600 file:text-white hover:file:bg-amber-500" />
          </div>
          <div>
            <label class="block text-xs font-medium text-gray-300 uppercase mb-1">Partitura / Documento (PDF - Opcional)</label>
            <input type="file" id="score-file" accept="application/pdf" class="w-full text-sm text-gray-400 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-gray-700 file:text-white hover:file:bg-gray-600" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase mb-1">Crédito de la Fuente / Procedencia (RF11)</label>
          <input type="text" id="source_credit" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-lg text-sm" placeholder="Ej: Archivo particular de Cátedra / Fuente externa" />
        </div>

        <div id="upload-status" class="hidden text-sm p-3 rounded-lg"></div>

        <button type="submit" id="submit-upload" class="px-6 py-2.5 bg-amber-600 hover:bg-amber-500 text-white font-medium rounded-lg text-sm transition shadow-lg">
          Subir y Publicar Pista
        </button>
      </form>
    </section>

    <section class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-xl">
      <h2 class="text-lg font-semibold mb-4">Pistas en el Repositorio</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-300">
          <thead class="bg-gray-800 text-xs uppercase text-gray-400">
            <tr>
              <th class="p-3">Título</th>
              <th class="p-3">Compositor</th>
              <th class="p-3">Estado</th>
              <th class="p-3 text-right">Acciones</th>
            </tr>
          </thead>
          <tbody id="tracks-table-body" class="divide-y divide-gray-800">
            <!-- Cargado por JS -->
          </tbody>
        </table>
      </div>
    </section>
  </main>
</Layout>

<script>
  import { supabaseBrowser as supabase } from '../lib/supabase-browser';

  async function checkAdminAndLoad() {
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      window.location.href = '/login';
      return;
    }

    const { data: profile } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    if (!profile || profile.role !== 'administrador') {
      window.location.href = '/';
      return;
    }

    const container = document.getElementById('admin-container');
    if (container) container.classList.remove('hidden');

    loadTracks();
  }

  async function loadTracks() {
    const { data: tracks, error } = await supabase
      .from('tracks')
      .select('*')
      .order('created_at', { ascending: false });

    const tbody = document.getElementById('tracks-table-body');
    if (!tbody) return;

    if (error || !tracks) {
      tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-red-400">Error al cargar las pistas.</td></tr>`;
      return;
    }

    tbody.innerHTML = tracks.map((track) => `
      <tr>
        <td class="p-3 font-medium text-white">${track.title}</td>
        <td class="p-3 text-gray-400">${track.composer}</td>
        <td class="p-3">
          <span class="px-2 py-0.5 rounded text-xs ${track.is_published ? 'bg-emerald-950 text-emerald-400 border border-emerald-800' : 'bg-red-950 text-red-400 border border-red-800'}">
            ${track.is_published ? 'Publicada' : 'Oculta'}
          </span>
        </td>
        <td class="p-3 text-right space-x-2">
          <button 
            onclick="window.togglePublish('${track.id}', ${!track.is_published})"
            class="px-3 py-1 bg-gray-800 hover:bg-gray-700 rounded text-xs transition"
          >
            ${track.is_published ? 'Ocultar' : 'Mostrar'}
          </button>
        </td>
      </tr>
    `).join('');
  }

  (window as any).togglePublish = async function(id: string, publishState: boolean) {
    const { error } = await supabase
      .from('tracks')
      .update({ is_published: publishState })
      .eq('id', id);

    if (error) {
      alert('Error al actualizar el estado: ' + error.message);
    } else {
      loadTracks();
    }
  };

  checkAdminAndLoad();

  const form = document.getElementById('upload-track-form') as HTMLFormElement;
  const statusDiv = document.getElementById('upload-status');
  const submitBtn = document.getElementById('submit-upload') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!statusDiv || !submitBtn) return;

    statusDiv.className = 'hidden text-sm p-3 rounded-lg';
    submitBtn.disabled = true;
    submitBtn.textContent = 'Subiendo archivos...';

    const title = (document.getElementById('title') as HTMLInputElement).value;
    const composer = (document.getElementById('composer') as HTMLInputElement).value;
    const source_credit = (document.getElementById('source_credit') as HTMLInputElement).value;
    const audioInput = document.getElementById('audio-file') as HTMLInputElement;
    const scoreInput = document.getElementById('score-file') as HTMLInputElement;

    const audioFile = audioInput.files?.[0];
    const scoreFile = scoreInput.files?.[0];

    if (!audioFile) {
      statusDiv.textContent = 'El archivo de audio es obligatorio.';
      statusDiv.className = 'text-sm text-red-400 bg-red-950/50 border border-red-900/50 p-3 rounded-lg';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subir y Publicar Pista';
      return;
    }

    try {
      const audioRes = await fetch('/api/upload-url', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename: audioFile.name, fileType: audioFile.type })
      });
      const audioData = await audioRes.json();
      if (!audioRes.ok) throw new Error(audioData.error);

      const audioPut = await fetch(audioData.uploadUrl, {
        method: 'PUT',
        headers: { 'Content-Type': audioFile.type },
        body: audioFile
      });
      if (!audioPut.ok) throw new Error('No se pudo subir el audio a R2 (revisa la política CORS del bucket).');
      const audioKey = audioData.objectKey;

      let scoreKey = null;
      if (scoreFile) {
        const scoreRes = await fetch('/api/upload-url', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ filename: scoreFile.name, fileType: scoreFile.type })
        });
        const scoreData = await scoreRes.json();
        if (!scoreRes.ok) throw new Error(scoreData.error);

        const scorePut = await fetch(scoreData.uploadUrl, {
          method: 'PUT',
          headers: { 'Content-Type': scoreFile.type },
          body: scoreFile
        });
        if (!scorePut.ok) throw new Error('No se pudo subir la partitura a R2 (revisa la política CORS del bucket).');
        scoreKey = scoreData.objectKey;
      }

      const { error: dbError } = await supabase.from('tracks').insert({
        title,
        composer,
        audio_key: audioKey,
        score_key: scoreKey,
        source_credit,
        is_published: true
      });

      if (dbError) throw new Error(dbError.message);

      statusDiv.textContent = '¡Pista subida y publicada con éxito!';
      statusDiv.className = 'text-sm text-emerald-400 bg-emerald-950/50 border border-emerald-900/50 p-3 rounded-lg';
      form.reset();
      loadTracks();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subir y Publicar Pista';

    } catch (err: any) {
      statusDiv.textContent = 'Error: ' + (err.message || 'Error desconocido');
      statusDiv.className = 'text-sm text-red-400 bg-red-950/50 border border-red-900/50 p-3 rounded-lg';
      submitBtn.disabled = false;
      submitBtn.textContent = 'Subir y Publicar Pista';
    }
  });
</script>