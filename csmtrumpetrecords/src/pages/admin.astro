---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, Upload, Pencil, Trash2, Eye, EyeOff, FileText, Music, Search, X } from 'lucide-astro';
import { SITE_CONFIG } from '../config';

// El middleware ya exige sesión y rol de administrador para /admin.
// Las pistas se leen aquí, en el servidor, con el token del usuario (RLS).
const profile = Astro.locals.profile;
const { data, error } = await Astro.locals.supabase
  .from('tracks')
  .select('id, title, composer, category, source_credit, is_published, audio_key, score_key, created_at')
  .order('created_at', { ascending: false });

const tracks = data ?? [];
const published = tracks.filter((t) => t.is_published).length;
const withScore = tracks.filter((t) => t.score_key).length;
const categories = [...new Set(tracks.map((t) => t.category).filter(Boolean))].sort() as string[];
---

<Layout title={`Administración | ${SITE_CONFIG.name}`}>
  <div class="min-h-screen bg-gray-50 text-gray-900 [color-scheme:light]">
    <header class="border-b border-gray-200 bg-white">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-4 sm:px-6">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-primary-600 text-white">
            <Music size={18} />
          </span>
          <div>
            <p class="text-sm font-semibold leading-tight">{SITE_CONFIG.name}</p>
            <p class="text-xs text-gray-500">Panel de administración</p>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <span class="hidden text-sm text-gray-600 sm:inline">{profile?.display_text}</span>
          <a href="/" class="btn-secondary"><ArrowLeft size={16} />Volver al aula</a>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl space-y-8 px-4 py-8 sm:px-6">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Repertorio y recursos</h1>
        <p class="mt-1 text-sm text-gray-500">Sube pistas y partituras, edita sus datos y decide qué ven los alumnos.</p>
      </div>

      <!-- Resumen -->
      <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        <div class="card p-4">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Pistas</dt>
          <dd class="mt-1 text-2xl font-semibold">{tracks.length}</dd>
        </div>
        <div class="card p-4">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Publicadas</dt>
          <dd class="mt-1 text-2xl font-semibold text-emerald-700">{published}</dd>
        </div>
        <div class="card p-4">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Ocultas</dt>
          <dd class="mt-1 text-2xl font-semibold text-gray-600">{tracks.length - published}</dd>
        </div>
        <div class="card p-4">
          <dt class="text-xs font-medium uppercase tracking-wide text-gray-500">Con partitura</dt>
          <dd class="mt-1 text-2xl font-semibold text-primary-700">{withScore}</dd>
        </div>
      </dl>

      <!-- Subir -->
      <section class="card p-6">
        <h2 class="text-base font-semibold">Subir nueva pista</h2>
        <p class="mt-1 text-sm text-gray-500">El audio es obligatorio (MP3). La partitura es opcional (PDF).</p>

        <form id="upload-form" class="mt-5 space-y-5">
          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label class="field-label" for="up-title">Título de la obra o movimiento</label>
              <input id="up-title" name="title" type="text" required maxlength="200" class="field" placeholder="Ej: Trumpet Concerto in D Major - I. Adagio" />
            </div>
            <div>
              <label class="field-label" for="up-composer">Compositor / autor</label>
              <input id="up-composer" name="composer" type="text" required maxlength="120" class="field" placeholder="Ej: Georg Philipp Telemann" />
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label class="field-label" for="up-audio">Archivo de audio (MP3)</label>
              <input id="up-audio" name="audio" type="file" accept="audio/mpeg,audio/mp3,.mp3" required class="field file:mr-3 file:rounded-md file:border-0 file:bg-primary-600 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-white hover:file:bg-primary-700" />
            </div>
            <div>
              <label class="field-label" for="up-score">Partitura (PDF, opcional)</label>
              <input id="up-score" name="score" type="file" accept="application/pdf,.pdf" class="field file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-3 file:py-1.5 file:text-xs file:font-medium file:text-gray-700 hover:file:bg-gray-200" />
            </div>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div>
              <label class="field-label" for="up-category">Categoría</label>
              <input id="up-category" name="category" type="text" list="category-list" maxlength="60" class="field" placeholder="Ej: Conciertos" />
            </div>
            <div>
              <label class="field-label" for="up-credit">Crédito de la fuente (RF11)</label>
              <input id="up-credit" name="source_credit" type="text" maxlength="300" class="field" placeholder="Ej: Archivo particular de la cátedra" />
            </div>
          </div>

          <datalist id="category-list">
            {categories.map((c) => <option value={c} />)}
          </datalist>

          <div class="flex items-center gap-4">
            <button type="submit" id="upload-submit" class="btn-primary"><Upload size={16} />Subir y publicar</button>
            <p id="upload-status" class="text-sm" role="status" aria-live="polite"></p>
          </div>
        </form>
      </section>

      <!-- Listado -->
      <section class="card overflow-hidden">
        <div class="flex flex-col gap-3 border-b border-gray-200 p-4 sm:flex-row sm:items-center sm:justify-between sm:p-5">
          <h2 class="text-base font-semibold">Pistas en el repositorio</h2>
          <div class="relative sm:w-72">
            <Search size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" />
            <input id="filter" type="search" class="field pl-9" placeholder="Buscar por título, compositor…" aria-label="Buscar pistas" />
          </div>
        </div>

        {error && <p class="p-6 text-sm text-red-600">No se han podido cargar las pistas. Recarga la página.</p>}

        {!error && (
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
              <thead class="bg-gray-50 text-xs uppercase tracking-wide text-gray-500">
                <tr>
                  <th scope="col" class="px-4 py-3 font-medium sm:px-5">Pista</th>
                  <th scope="col" class="hidden px-4 py-3 font-medium md:table-cell">Categoría</th>
                  <th scope="col" class="hidden px-4 py-3 font-medium md:table-cell">Archivos</th>
                  <th scope="col" class="px-4 py-3 font-medium">Estado</th>
                  <th scope="col" class="px-4 py-3 text-right font-medium sm:px-5">Acciones</th>
                </tr>
              </thead>
              <tbody id="tracks-body" class="divide-y divide-gray-100">
                {tracks.map((t) => (
                  <tr
                    data-row
                    data-id={t.id}
                    data-title={t.title}
                    data-composer={t.composer}
                    data-category={t.category ?? ''}
                    data-credit={t.source_credit ?? ''}
                    data-published={String(t.is_published)}
                    data-has-score={String(!!t.score_key)}
                    data-search={`${t.title} ${t.composer} ${t.category ?? ''}`.toLowerCase()}
                    class="hover:bg-gray-50/70"
                  >
                    <td class="px-4 py-3 sm:px-5">
                      <p class="font-medium text-gray-900">{t.title}</p>
                      <p class="text-gray-500">{t.composer}</p>
                    </td>
                    <td class="hidden px-4 py-3 text-gray-600 md:table-cell">{t.category ?? '—'}</td>
                    <td class="hidden px-4 py-3 md:table-cell">
                      <span class="inline-flex items-center gap-3 text-xs">
                        <span class:list={['inline-flex items-center gap-1', t.audio_key ? 'text-gray-700' : 'text-red-600']}>
                          <Music size={14} />{t.audio_key ? 'MP3' : 'Sin audio'}
                        </span>
                        <span class:list={['inline-flex items-center gap-1', t.score_key ? 'text-primary-700' : 'text-gray-400']}>
                          <FileText size={14} />{t.score_key ? 'PDF' : 'Sin partitura'}
                        </span>
                      </span>
                    </td>
                    <td class="px-4 py-3">
                      <span class:list={['badge ring-1', t.is_published ? 'bg-emerald-50 text-emerald-700 ring-emerald-600/20' : 'bg-gray-100 text-gray-600 ring-gray-500/20']}>
                        {t.is_published ? 'Publicada' : 'Oculta'}
                      </span>
                    </td>
                    <td class="px-4 py-3 sm:px-5">
                      <div class="flex justify-end gap-1">
                        <button type="button" data-action="toggle" class="btn-ghost" title={t.is_published ? 'Ocultar a los alumnos' : 'Publicar'} aria-label={`${t.is_published ? 'Ocultar' : 'Publicar'}: ${t.title}`}>
                          {t.is_published ? <EyeOff size={16} /> : <Eye size={16} />}
                        </button>
                        <button type="button" data-action="edit" class="btn-ghost" title="Editar" aria-label={`Editar: ${t.title}`}>
                          <Pencil size={16} />
                        </button>
                        <button type="button" data-action="delete" class="btn-ghost hover:bg-red-50 hover:text-red-700" title="Borrar" aria-label={`Borrar: ${t.title}`}>
                          <Trash2 size={16} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p id="empty-state" class:list={['p-8 text-center text-sm text-gray-500', tracks.length > 0 && 'hidden']}>
              {tracks.length === 0 ? 'Todavía no hay pistas. Sube la primera arriba.' : 'Ninguna pista coincide con la búsqueda.'}
            </p>
          </div>
        )}
      </section>
    </main>
  </div>

  <!-- Editar -->
  <dialog id="edit-dialog" class="[color-scheme:light] m-auto w-[calc(100%-2rem)] max-w-lg rounded-xl bg-white p-0 text-gray-900 shadow-xl backdrop:bg-gray-900/50">
    <form id="edit-form" class="space-y-5 p-6">
      <div class="flex items-start justify-between gap-4">
        <h2 class="text-base font-semibold">Editar pista</h2>
        <button type="button" data-close class="btn-ghost -mr-2 -mt-1" aria-label="Cerrar"><X size={18} /></button>
      </div>

      <div>
        <label class="field-label" for="ed-title">Título</label>
        <input id="ed-title" name="title" type="text" required maxlength="200" class="field" />
      </div>
      <div>
        <label class="field-label" for="ed-composer">Compositor / autor</label>
        <input id="ed-composer" name="composer" type="text" required maxlength="120" class="field" />
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for="ed-category">Categoría</label>
          <input id="ed-category" name="category" type="text" list="category-list" maxlength="60" class="field" />
        </div>
        <div>
          <label class="field-label" for="ed-credit">Crédito de la fuente</label>
          <input id="ed-credit" name="source_credit" type="text" maxlength="300" class="field" />
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label class="field-label" for="ed-audio">Sustituir audio (MP3)</label>
          <input id="ed-audio" name="audio" type="file" accept="audio/mpeg,audio/mp3,.mp3" class="field file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-2 file:py-1 file:text-xs" />
        </div>
        <div>
          <label class="field-label" for="ed-score">
            <span id="ed-score-label">Partitura (PDF)</span>
          </label>
          <input id="ed-score" name="score" type="file" accept="application/pdf,.pdf" class="field file:mr-3 file:rounded-md file:border-0 file:bg-gray-100 file:px-2 file:py-1 file:text-xs" />
        </div>
      </div>

      <label id="ed-remove-score-wrap" class="flex items-center gap-2 text-sm text-gray-700">
        <input id="ed-remove-score" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-600" />
        Quitar la partitura actual
      </label>

      <label class="flex items-center gap-2 text-sm text-gray-700">
        <input id="ed-published" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-600" />
        Visible para los alumnos
      </label>

      <p id="edit-error" class="hidden text-sm text-red-600" role="alert"></p>

      <div class="flex justify-end gap-2 border-t border-gray-100 pt-4">
        <button type="button" data-close class="btn-secondary">Cancelar</button>
        <button type="submit" id="edit-submit" class="btn-primary">Guardar cambios</button>
      </div>
    </form>
  </dialog>

  <!-- Borrar -->
  <dialog id="delete-dialog" class="[color-scheme:light] m-auto w-[calc(100%-2rem)] max-w-md rounded-xl bg-white p-0 text-gray-900 shadow-xl backdrop:bg-gray-900/50">
    <div class="space-y-4 p-6">
      <h2 class="text-base font-semibold">¿Borrar esta pista?</h2>
      <p class="text-sm text-gray-600">
        Se eliminará <strong id="delete-title" class="font-medium text-gray-900"></strong>
        junto con su audio y su partitura. No se puede deshacer.
      </p>
      <p id="delete-error" class="hidden text-sm text-red-600" role="alert"></p>
      <div class="flex justify-end gap-2">
        <button type="button" data-close class="btn-secondary">Cancelar</button>
        <button type="button" id="delete-confirm" class="btn-danger">Borrar definitivamente</button>
      </div>
    </div>
  </dialog>

  <!-- Avisos -->
  <div id="toast" class="pointer-events-none fixed inset-x-4 bottom-4 z-50 mx-auto hidden max-w-sm rounded-lg px-4 py-3 text-sm font-medium text-white shadow-lg" role="status" aria-live="polite"></div>
</Layout>

<script>
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector(sel) as T;

  // ---- Utilidades -------------------------------------------------------
  function toast(message: string, kind: 'ok' | 'error' = 'ok') {
    const el = $('#toast');
    el.textContent = message;
    el.className = `pointer-events-none fixed inset-x-4 bottom-4 z-50 mx-auto max-w-sm rounded-lg px-4 py-3 text-sm font-medium text-white shadow-lg ${
      kind === 'ok' ? 'bg-emerald-700' : 'bg-red-600'
    }`;
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  /** Recarga la página para ver la lista actualizada y deja un aviso para después. */
  function reloadWith(message: string) {
    try { sessionStorage.setItem('admin-flash', message); } catch {}
    location.reload();
  }

  try {
    const flash = sessionStorage.getItem('admin-flash');
    if (flash) { sessionStorage.removeItem('admin-flash'); toast(flash); }
  } catch {}

  async function api(url: string, method: string, body?: unknown) {
    const res = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || `Error ${res.status}`);
    return data;
  }

  function contentType(file: File): string {
    if (file.type) return file.type;
    return file.name.toLowerCase().endsWith('.pdf') ? 'application/pdf' : 'audio/mpeg';
  }

  /** Sube un archivo a R2 con URL firmada y devuelve su clave de objeto. */
  async function uploadFile(file: File): Promise<string> {
    const type = contentType(file);
    const { uploadUrl, objectKey } = await api('/api/upload-url', 'POST', { filename: file.name, fileType: type });
    const put = await fetch(uploadUrl, { method: 'PUT', headers: { 'Content-Type': type }, body: file });
    if (!put.ok) throw new Error(`No se pudo subir «${file.name}» a R2 (¿política CORS del bucket?).`);
    return objectKey;
  }

  const rowOf = (el: Element) => el.closest<HTMLElement>('[data-row]')!;

  // ---- Subir ------------------------------------------------------------
  const uploadForm = $<HTMLFormElement>('#upload-form');
  uploadForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = $('#upload-status');
    const btn = $<HTMLButtonElement>('#upload-submit');
    const fd = new FormData(uploadForm);
    const audio = fd.get('audio') as File;
    const score = fd.get('score') as File;

    btn.disabled = true;
    status.className = 'text-sm text-gray-500';
    status.textContent = 'Subiendo archivos…';
    try {
      const audio_key = await uploadFile(audio);
      const score_key = score && score.size > 0 ? await uploadFile(score) : null;
      await api('/api/tracks', 'POST', {
        title: fd.get('title'),
        composer: fd.get('composer'),
        category: fd.get('category'),
        source_credit: fd.get('source_credit'),
        audio_key,
        score_key,
      });
      reloadWith('Pista subida y publicada.');
    } catch (err) {
      status.className = 'text-sm text-red-600';
      status.textContent = (err as Error).message;
      btn.disabled = false;
    }
  });

  // ---- Buscar -----------------------------------------------------------
  const filter = $<HTMLInputElement>('#filter');
  filter.addEventListener('input', () => {
    const q = filter.value.trim().toLowerCase();
    let visible = 0;
    document.querySelectorAll<HTMLElement>('[data-row]').forEach((row) => {
      const show = !q || (row.dataset.search ?? '').includes(q);
      row.hidden = !show;
      if (show) visible++;
    });
    $('#empty-state').classList.toggle('hidden', visible > 0);
  });

  // ---- Acciones por fila ------------------------------------------------
  const editDialog = $<HTMLDialogElement>('#edit-dialog');
  const deleteDialog = $<HTMLDialogElement>('#delete-dialog');
  let currentId = '';

  document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) =>
    b.addEventListener('click', () => b.closest('dialog')?.close())
  );

  $('#tracks-body')?.addEventListener('click', async (e) => {
    const btn = (e.target as Element).closest<HTMLButtonElement>('[data-action]');
    if (!btn) return;
    const row = rowOf(btn);
    currentId = row.dataset.id!;

    if (btn.dataset.action === 'toggle') {
      btn.disabled = true;
      try {
        const now = row.dataset.published === 'true';
        await api(`/api/tracks/${currentId}`, 'PATCH', { is_published: !now });
        reloadWith(now ? 'Pista oculta a los alumnos.' : 'Pista publicada.');
      } catch (err) {
        toast((err as Error).message, 'error');
        btn.disabled = false;
      }
    }

    if (btn.dataset.action === 'edit') {
      $<HTMLInputElement>('#ed-title').value = row.dataset.title ?? '';
      $<HTMLInputElement>('#ed-composer').value = row.dataset.composer ?? '';
      $<HTMLInputElement>('#ed-category').value = row.dataset.category ?? '';
      $<HTMLInputElement>('#ed-credit').value = row.dataset.credit ?? '';
      $<HTMLInputElement>('#ed-published').checked = row.dataset.published === 'true';
      $<HTMLInputElement>('#ed-audio').value = '';
      $<HTMLInputElement>('#ed-score').value = '';
      $<HTMLInputElement>('#ed-remove-score').checked = false;
      const hasScore = row.dataset.hasScore === 'true';
      $('#ed-remove-score-wrap').classList.toggle('hidden', !hasScore);
      $('#ed-score-label').textContent = hasScore ? 'Sustituir partitura (PDF)' : 'Añadir partitura (PDF)';
      $('#edit-error').classList.add('hidden');
      editDialog.showModal();
    }

    if (btn.dataset.action === 'delete') {
      $('#delete-title').textContent = `«${row.dataset.title}»`;
      $('#delete-error').classList.add('hidden');
      deleteDialog.showModal();
    }
  });

  // ---- Guardar edición --------------------------------------------------
  $<HTMLFormElement>('#edit-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('#edit-error');
    const btn = $<HTMLButtonElement>('#edit-submit');
    err.classList.add('hidden');
    btn.disabled = true;
    btn.textContent = 'Guardando…';
    try {
      const body: Record<string, unknown> = {
        title: $<HTMLInputElement>('#ed-title').value,
        composer: $<HTMLInputElement>('#ed-composer').value,
        category: $<HTMLInputElement>('#ed-category').value,
        source_credit: $<HTMLInputElement>('#ed-credit').value,
        is_published: $<HTMLInputElement>('#ed-published').checked,
      };
      const audio = $<HTMLInputElement>('#ed-audio').files?.[0];
      const score = $<HTMLInputElement>('#ed-score').files?.[0];
      if (audio) body.audio_key = await uploadFile(audio);
      if (score) body.score_key = await uploadFile(score);
      else if ($<HTMLInputElement>('#ed-remove-score').checked) body.score_key = null;

      await api(`/api/tracks/${currentId}`, 'PATCH', body);
      reloadWith('Cambios guardados.');
    } catch (e2) {
      err.textContent = (e2 as Error).message;
      err.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Guardar cambios';
    }
  });

  // ---- Confirmar borrado ------------------------------------------------
  $<HTMLButtonElement>('#delete-confirm').addEventListener('click', async () => {
    const btn = $<HTMLButtonElement>('#delete-confirm');
    const err = $('#delete-error');
    btn.disabled = true;
    err.classList.add('hidden');
    try {
      await api(`/api/tracks/${currentId}`, 'DELETE');
      reloadWith('Pista borrada.');
    } catch (e2) {
      err.textContent = (e2 as Error).message;
      err.classList.remove('hidden');
      btn.disabled = false;
    }
  });
</script>
