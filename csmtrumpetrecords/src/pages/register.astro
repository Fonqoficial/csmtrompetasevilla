---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAAFgimFZb1S5C2hHZ';
---

<Layout title={`Registro | ${SITE_CONFIG.name}`}>
  <main class="min-h-screen flex items-center justify-center bg-gray-950 px-4 py-8">
    <div class="max-w-md w-full bg-gray-900 border border-gray-800 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white tracking-tight">Crear Cuenta</h1>
        <p class="text-sm text-gray-400 mt-2">Registro de acceso para el Aula de Trompeta</p>
      </div>

      <form id="register-form" class="space-y-5">
        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Nombre para mostrar</label>
          <input 
            type="text" 
            id="display_text" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm"
            placeholder="Tu Nombre y Apellidos"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Correo electrónico</label>
          <input 
            type="email" 
            id="email" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm"
            placeholder="tu.correo@alumnos.csmsevilla.com"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            required 
            minlength="6"
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:border-transparent text-sm"
            placeholder="Mínimo 6 caracteres"
          />
        </div>

        <div class="flex justify-center my-2">
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
        </div>

        <div id="error-message" class="hidden text-sm text-red-400 bg-red-950/50 border border-red-900/50 p-3 rounded-lg"></div>
        <div id="success-message" class="hidden text-sm text-emerald-400 bg-emerald-950/50 border border-emerald-900/50 p-3 rounded-lg"></div>

        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-500 text-white font-medium rounded-lg transition duration-200 text-sm shadow-lg shadow-amber-900/20"
        >
          Completar Registro
        </button>
      </form>

      <!-- Divisor -->
      <div class="relative flex py-4 items-center">
        <div class="flex-grow border-t border-gray-800"></div>
        <span class="flex-shrink mx-4 text-xs text-gray-500 uppercase">o registrarse con</span>
        <div class="flex-grow border-t border-gray-800"></div>
      </div>

      <!-- Botón Google OAuth -->
      <button 
        type="button" 
        id="google-register-btn"
        class="w-full py-3 px-4 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg transition duration-200 text-sm flex items-center justify-center gap-3 border border-gray-700 shadow-sm"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.1 9 5 12 5z"/>
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.8s.2-2 .4-2.8L1.9 6.3C.7 8.7 0 11.3 0 14s.7 5.3 1.9 7.7l3.7-2.9z"/>
          <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.1-6.4-5.2L1.9 15c1.8 3.7 5.6 8 10.1 8z"/>
        </svg>
        Registrarse con Google
      </button>

      <div class="text-center mt-6">
        <p class="text-sm text-gray-400">
          ¿Ya tienes cuenta? <a href="/login" class="text-amber-400 font-medium hover:underline">Inicia sesión</a>
        </p>
      </div>
    </div>
  </main>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('register-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message');
    const successDiv = document.getElementById('success-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const googleBtn = document.getElementById('google-register-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!errorDiv || !successDiv || !submitBtn) return;

      const turnstileResponse = (document.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement)?.value;
      if (!turnstileResponse) {
        errorDiv.textContent = 'Por favor, completa la verificación de seguridad (Turnstile).';
        errorDiv.classList.remove('hidden');
        return;
      }

      errorDiv.classList.add('hidden');
      successDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Registrando...';

      const display_text = (document.getElementById('display_text') as HTMLInputElement).value;
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      const { error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: { display_text }
        }
      });

      if (error) {
        errorDiv.textContent = error.message;
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Completar Registro';
        return;
      }

      successDiv.textContent = '¡Registro exitoso! Revisa tu correo electrónico para verificar la cuenta antes de iniciar sesión.';
      successDiv.classList.remove('hidden');
      form.reset();
      submitBtn.disabled = false;
      submitBtn.textContent = 'Completar Registro';
    });

    googleBtn?.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: `${window.location.origin}/`
        }
      });
      if (error && errorDiv) {
        errorDiv.textContent = error.message;
        errorDiv.classList.remove('hidden');
      }
    });
  </script>
</Layout>