---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
---

<Layout title={`Acceso | ${SITE_CONFIG.name}`}>
  <main class="min-h-screen flex items-center justify-center bg-gray-950 px-4 py-8">
    <div class="max-w-md w-full bg-gray-900 border border-gray-800 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white tracking-tight">{SITE_CONFIG.name}</h1>
        <p class="text-sm text-gray-400 mt-2">Introduce tus credenciales para acceder al aula</p>
      </div>

      <form id="login-form" class="space-y-6">
        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Correo electrónico</label>
          <input 
            type="email" 
            id="email" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"
            placeholder="tu.correo@alumnos.csmsevilla.com"
          />
        </div>

        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider">Contraseña</label>
            <a href="/forgot-password" class="text-xs text-amber-400 hover:underline">¿Has olvidado tu contraseña?</a>
          </div>
          <input 
            type="password" 
            id="password" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"
            placeholder="••••••••"
          />
        </div>

        <div id="error-message" class="hidden text-sm text-red-400 bg-red-950/50 border border-red-900/50 p-3 rounded-lg"></div>
        
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-500 text-white font-medium rounded-lg transition duration-200 text-sm shadow-lg"
        >
          Iniciar Sesión
        </button>
      </form>

      <!-- Divisor -->
      <div class="relative flex py-4 items-center">
        <div class="flex-grow border-t border-gray-800"></div>
        <span class="flex-shrink mx-4 text-xs text-gray-500 uppercase">o continuar con</span>
        <div class="flex-grow border-t border-gray-800"></div>
      </div>

      <!-- Botón Google OAuth -->
      <button 
        type="button" 
        id="google-login-btn"
        class="w-full py-3 px-4 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg transition duration-200 text-sm flex items-center justify-center gap-3 border border-gray-700 shadow-sm"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24">
          <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.5 1 3.7 3.6 1.9 7.3l3.7 2.9C6.5 7.1 9 5 12 5z"/>
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/>
          <path fill="#FBBC05" d="M5.6 14.8c-.2-.7-.4-1.5-.4-2.8s.2-2 .4-2.8L1.9 6.3C.7 8.7 0 11.3 0 14s.7 5.3 1.9 7.7l3.7-2.9z"/>
          <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3 0-5.5-2.1-6.4-5.2L1.9 15c1.8 3.7 5.6 8 10.1 8z"/>
        </svg>
        Continuar con Google
      </button>

      <div class="text-center mt-6">
        <p class="text-sm text-gray-400">
          ¿No tienes una cuenta? <a href="/register" class="text-amber-400 font-medium hover:underline">Regístrate aquí</a>
        </p>
      </div>
    </div>
  </main>
  
  <script>
    import { supabaseBrowser as supabase } from '../lib/supabase-browser';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const googleBtn = document.getElementById('google-login-btn');

    // Destino tras entrar (solo rutas internas)
    const rawNext = new URLSearchParams(window.location.search).get('next') || '/';
    const next = rawNext.startsWith('/') && !rawNext.startsWith('//') && !rawNext.startsWith('/\\') ? rawNext : '/';

    if (new URLSearchParams(window.location.search).get('error') === 'callback' && errorDiv) {
      errorDiv.textContent = 'No se pudo completar el acceso. Inténtalo de nuevo.';
      errorDiv.classList.remove('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!errorDiv || !submitBtn) return;

      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Iniciando sesión...';

      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      try {
        const response = await fetch('/api/auth/signin', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const result = await response.json();

        if (!response.ok) {
          errorDiv.textContent = result.error || 'Error al iniciar sesión';
          errorDiv.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Iniciar Sesión';
          return;
        }

        window.location.href = next;
      } catch (err) {
        errorDiv.textContent = 'Error de conexión con el servidor.';
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Iniciar Sesión';
      }
    });

    googleBtn?.addEventListener('click', async () => {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback?next=${encodeURIComponent(next)}` }
      });
    });
  </script>
</Layout>