---
import Layout from '../layouts/Layout.astro';
import { SITE_CONFIG } from '../config';
---

<Layout title={`Acceso | ${SITE_CONFIG.name}`}>
  <main class="min-h-screen flex items-center justify-center bg-gray-950 px-4 py-8">
    <div class="max-w-md w-full bg-gray-900 border border-gray-800 rounded-2xl p-8 shadow-2xl">
      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-white tracking-tight">{SITE_CONFIG.name}</h1>
        <p class="text-sm text-gray-400 mt-2">Acceso al aula del conservatorio</p>
      </div>

      <form id="login-form" class="space-y-6">
        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Correo electrónico</label>
          <input 
            type="email" 
            id="email" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"
            placeholder="tu.correo@alumnos.csmsevilla.com"
          />
        </div>

        <div>
          <label class="block text-xs font-medium text-gray-300 uppercase tracking-wider mb-2">Contraseña</label>
          <input 
            type="password" 
            id="password" 
            required 
            class="w-full px-4 py-3 bg-gray-800 border border-gray-700 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-amber-500 text-sm"
            placeholder="••••••••"
          />
        </div>

        <div id="error-message" class="hidden text-sm text-red-400 bg-red-950/50 border border-red-900/50 p-3 rounded-lg"></div>
        
        <button 
          type="submit" 
          id="submit-btn"
          class="w-full py-3 px-4 bg-amber-600 hover:bg-amber-500 text-white font-medium rounded-lg transition duration-200 text-sm shadow-lg"
        >
          Entrar al Aula
        </button>
      </form>

      <div class="mt-4">
        <button 
          type="button" 
          id="google-login-btn"
          class="w-full py-3 px-4 bg-gray-800 hover:bg-gray-700 text-white font-medium rounded-lg transition duration-200 text-sm flex items-center justify-center gap-3 border border-gray-700 shadow-sm"
        >
          Continuar con Google
        </button>
      </div>

      <div class="text-center mt-6">
        <p class="text-sm text-gray-400">
          ¿No tienes cuenta? <a href="/register" class="text-amber-400 font-medium hover:underline">Regístrate</a>
        </p>
      </div>
    </div>
  </main>

  <script>
    import { supabase } from '../lib/supabase';

    const form = document.getElementById('login-form') as HTMLFormElement;
    const errorDiv = document.getElementById('error-message');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const googleBtn = document.getElementById('google-login-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!errorDiv || !submitBtn) return;

      errorDiv.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Entrando...';

      const email = (document.getElementById('email') as HTMLInputElement).value;
      const password = (document.getElementById('password') as HTMLInputElement).value;

      const { error } = await supabase.auth.signInWithPassword({ email, password });

      if (error) {
        errorDiv.textContent = error.message;
        errorDiv.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar al Aula';
        return;
      }

      window.location.href = '/';
    });

    googleBtn?.addEventListener('click', async () => {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/` }
      });
    });
  </script>
</Layout>