---
import Layout from '../layouts/Layout.astro';
import TrackCard from '../components/TrackCard.astro';
import { FileText } from 'lucide-astro';
import { SITE_CONFIG } from '../config';
import { groupTracks, type TrackRow } from '../lib/tracks';

// Sesión y perfil los deja resueltos el middleware.
const user = Astro.locals.user!;
const profile = Astro.locals.profile;

// Con el token del usuario: RLS decide qué pistas ve (publicadas; las ocultas, solo admin).
const { data, error } = await Astro.locals.supabase
  .from('tracks')
  .select('id, title, composer, audio_key, score_key, created_at')
  .order('created_at', { ascending: true });

if (error) console.error('[index] Error leyendo las pistas:', error.message);
const works = groupTracks((data ?? []) as TrackRow[]);
---

<Layout title={SITE_CONFIG.title}>
  <main class="min-h-screen bg-gray-950 text-white p-6 max-w-4xl mx-auto">
    <header class="flex justify-between items-center mb-8 pb-4 border-b border-gray-800">
      <div>
        <h1 class="text-xl font-bold">{SITE_CONFIG.name}</h1>
        <p class="text-xs text-gray-400">Aula de Trompeta - CSM Manuel Castillo</p>
      </div>
      <div class="flex items-center gap-4">
        <div class="text-right">
          <p class="text-sm font-medium text-amber-400">{profile?.display_text || user.email}</p>
          <span class="text-xs uppercase tracking-wider bg-gray-800 px-2 py-0.5 rounded text-gray-300">
            {profile?.role || 'alumno'}
          </span>
        </div>
        <form action="/api/auth/signout" method="POST">
          <button 
            type="submit" 
            class="px-3 py-1.5 bg-gray-800 hover:bg-gray-700 text-gray-300 text-xs rounded-lg transition"
          >
            Cerrar Sesión
          </button>
        </form>
      </div>
    </header>

    <section class="space-y-6">
      {profile?.role === 'administrador' && (
        <div class="mb-4">
          <a href="/admin" class="inline-block px-4 py-2 bg-amber-600 hover:bg-amber-500 text-white rounded-lg text-sm font-medium transition">
            Ir al Panel de Administración →
          </a>
        </div>
      )}
      <h2 class="text-lg font-semibold text-gray-200">Repositorio de Pistas y Recursos</h2>

      {error && (
        <p class="text-sm text-red-400">No se han podido cargar las pistas. Inténtalo de nuevo en unos minutos.</p>
      )}
      {!error && works.length === 0 && (
        <p class="text-sm text-gray-400">Todavía no hay pistas publicadas.</p>
      )}

      <div class="theme-dark">
        {works.map((w) => (
          <section class="work">
            <div class="work-head">
              <div>
                <h2>{w.work}</h2>
                <p class="composer">{w.composer}</p>
              </div>
              {w.scoreId && (
                <a class="score" href={`/api/download/${w.scoreId}?type=score`}>
                  <FileText size={15} />Partitura (PDF)
                </a>
              )}
            </div>
            <ul class="movs">
              {w.movements.map((m) => (
                <TrackCard track={{ id: m.id, title: m.title, composer: w.composer, is_published: true, mov: m.mov }} work={w.work} />
              ))}
            </ul>
          </section>
        ))}
      </div>
    </section>
  </main>
</Layout>